node_modules
dist
dist-ssr
*.local
.DS_Store
coverage
.vite
*.log
.claude/

# Playwright e2e output (reports, traces, recorded videos).
test-results/
playwright-report/

# Generated from the vocab YAML on every build (and predev) — see
# scripts/gen-manifest.mjs. The manifest and the per-file JSON the client
# fetches are both derived from the authoring `.yml`; not committed so parallel
# vocab edits don't conflict over them.
public/vocab/*.json

# Translation-review work packets — regenerate with
# `node scripts/audit-translations.mjs --shard`. Derived from the vocab YAML,
# so not committed; the reviewers' proposals in review/proposals/ are.
review/packets/
review/quarantine-russian.jsonl

# Gloss-review work packets — regenerate with `node scripts/gloss-packets.mjs`.
# Derived from the proposals + vocab; the reviewers' *.jsonl beside them are
# the record and stay tracked.
review/gloss/*.json
