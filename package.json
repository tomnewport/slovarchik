{
  "name": "slovarchik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA for drilling Russian vocabulary and noun declensions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/gen-manifest.mjs",
    "dev": "vite",
    "build": "node scripts/gen-manifest.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.vue",
    "check:ci": "node scripts/check-ci.mjs",
    "check:corpus": "node scripts/check-ci.mjs --corpus",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "check:stress": "node scripts/check-stress.mjs",
    "check:morph": "node scripts/check-morphology.mjs",
    "check:inflect": "node scripts/annotate-inflect.mjs --check",
    "check:inflect:cases": "node scripts/triage-inflect.mjs --verify",
    "check:prompts": "node scripts/check-prompt-ambiguity.mjs",
    "audit:gender": "node scripts/gender-audit.mjs",
    "audit:translations": "node scripts/audit-translations.mjs --report",
    "audit:alternates": "node scripts/audit-translations.mjs --alternates",
    "verify:review": "node scripts/verify-review-replay.mjs",
    "audit:yield": "node scripts/review-yield.mjs",
    "audit:cefr": "node scripts/audit-cefr.js",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:adjectives": "node scripts/gen-adjective-declension.mjs",
    "promote:glossary": "node scripts/promote-glossary.mjs",
    "coverage:facts": "node scripts/coverage-facts.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "fake-indexeddb": "^6.2.5",
    "js-yaml": "^4.1.1",
    "jsdom": "^25.0.1",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
